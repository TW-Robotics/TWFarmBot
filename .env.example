# Local TWFarmbotOS HTTP API (Raspberry Pi, default sim on :3001)
# FARMBOT_LOCAL_URL=http://127.0.0.1:3001
# FARMBOT_TRANSPORT=sim
# FARMBOT_SERIAL_PATH=/dev/ttyACM0
# FARMBOT_SERIAL_BAUD=115200
# FARMBOT_OS_PORT=3001
# FARMBOT_PHOTO_DIR=data/farmbot_photos
# FARMBOT_QUEUE_SUFFIX=1
# FARMBOT_REQUIRE_CONFIG=1
# FARMBOT_PUMP_PIN=8
# FARMBOT_MOVE_SPEED=100          # default move speed percent (1..100)
# FARMBOT_ACCEL_STEPS=600         # accel/decel ramp steps (P41-P43); auto-raised to 600 if lower
# FARMBOT_STEALTH=1               # TMC quiet mode on boot (P165-P167); set 0 for louder spreadCycle
# FARMBOT_CAMERA_EXPOSURE=300     # UVC manual exposure (Sunplus FHD)

# If you want to run the UI/API without a live bot, set this to 0
# FARMBOT_REQUIRED=1

# General runtime settings
# FARMBOT_ENV=dev
# FARMBOT_LOG_LEVEL=INFO

# Safety: water duration always. Axis caps only if FARMBOT_ENFORCE_WORKSPACE=1.
# FARMBOT_MAX_WATER_SECONDS=300
# FARMBOT_ENFORCE_WORKSPACE=0
# FARMBOT_MAX_AXIS_X=650
# FARMBOT_MAX_AXIS_Y=1900
# FARMBOT_MAX_AXIS_Z=300

# Watering/hardware overrides (defaults shown)
# WATERING_BACKEND=farmbot
# FARMBOT_PUMP_PIN=7

# LLM planner configuration (required for AI planning / assistant tab)
PLANNING_LLM_API_KEY=
# PLANNING_LLM_PROVIDER=openrouter
# PLANNING_LLM_BASE_URL=https://openrouter.ai/api/v1
# PLANNING_LLM_MODEL=ibm-granite/granite-4.1-8b
# PLANNING_LLM_TIMEOUT_S=120
# PLANNING_LLM_TEMPERATURE=0.0

# Google Vertex AI (uses your GCP credits via the OpenAI-compatible endpoint).
# Auth: service-account JSON key with the Vertex AI User role (or ADC).
# 1) Enable the Vertex AI API on your GCP project.
# 2) Put the key on this machine (chmod 600) and set the vars below.
# PLANNING_LLM_PROVIDER=vertex
# PLANNING_LLM_MODEL=gemini-2.5-flash
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/home/david/.config/gcloud/farmbot-vertex.json

# Optional W&B Weave tracing project
# WEAVE_PROJECT=

# UI / API wiring (defaults shown)
# TWFB_API_URL=http://127.0.0.1:8000
# TWFB_UI_PORT=8501
# TWFB_RESIREG_URL=http://127.0.0.1:8080
# TWFB_CONFIG=configs/dev.yaml
# TWFB_UI_DATA_DIR=data/ui_sessions
