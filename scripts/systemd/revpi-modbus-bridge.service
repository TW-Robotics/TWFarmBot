[Unit]
Description=TWFarmBot RevPi Modbus-to-DIO bridge
After=network-online.target revpipyload.service
Wants=network-online.target revpipyload.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/TWFarmBot
Environment="HOME=/root"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 /home/pi/TWFarmBot/scripts/revpi_modbus_bridge.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=revpi-modbus-bridge

[Install]
WantedBy=multi-user.target
