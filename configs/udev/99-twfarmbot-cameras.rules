# TWFarmBot payload USB cameras (Pi: 1× Sunplus FHD + 2× DMK 37BUX290).
# Bind stable symlinks so rgb / nir / rededge never race for /dev/videoN.
# Software opens /dev/camera-{band} only — never /dev/videoN.
#
# Install:
#   sudo cp configs/udev/99-twfarmbot-cameras.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Verify: ls -l /dev/camera-*

# Sunplus FHD camera (no USB serial — match vendor/product)
SUBSYSTEM=="video4linux", KERNEL=="video*", ATTR{index}=="0", ATTRS{idVendor}=="1bcf", ATTRS{idProduct}=="2085", SYMLINK+="camera-rgb"

# The Imaging Source DMK 37BUX290 — physical NIR (47520551)
SUBSYSTEM=="video4linux", KERNEL=="video*", ATTR{index}=="0", ATTRS{serial}=="47520551", SYMLINK+="camera-nir"

# The Imaging Source DMK 37BUX290 — physical red-edge (47520552)
SUBSYSTEM=="video4linux", KERNEL=="video*", ATTR{index}=="0", ATTRS{serial}=="47520552", SYMLINK+="camera-rededge"
